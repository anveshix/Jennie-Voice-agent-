{
  "extraKnownMarketplaces": {
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "enabledPlugins": {
    "ruflo-console@ruflo": true,
    "ruflo-mods@ruflo": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(node server.js)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
