# ---------------------------------------------------------------------------
# Optional: .env is the traditional way to configure the provider.
# You can also skip this file entirely and use the API Room in the browser
# (it saves to storage/settings.json, which is git-ignored and takes priority).
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL. Remote URLs must be HTTPS.
# Examples:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (local, no key needed)
AI_BASE_URL=https://api.openai.com/v1

# Your own key. Never commit this file.
AI_API_KEY=

# Chat model served by that provider.
AI_MODEL=gpt-4o-mini

# Server-side speech-to-text model. Leave empty to disable transcription
# (browser speech recognition still works).
AI_TRANSCRIPTION_MODEL=whisper-1

# Port for the local server.
PORT=3000

# Optional path to private school knowledge (default storage/school_knowledge.md, git-ignored)
# SCHOOL_KNOWLEDGE_FILE=

# ---------------- Always-on automation (see AUTOMATION.md) ----------------
# Required when the server is reachable from the internet (protects /api/auto and the AI key).
# JENNI_ACCESS_TOKEN=
# Encrypts student marks at rest (else a key is generated in storage/data.key). Back this up.
# JENNI_DATA_KEY=
# Set 0 to disable scheduler + Telegram bot.
# JENNI_AUTOMATION=1
# Gmail / Calendar / Sheets (one refresh token; scopes: gmail.readonly gmail.compose gmail.send calendar sheets)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
